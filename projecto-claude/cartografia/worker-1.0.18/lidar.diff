+def _descarregar_folha(api, href, base, dst, registo, cfg=None, dormir=time.sleep):
+    """Uma folha, com novas tentativas espaçadas (rede.tentar). A sessão do CDD é renovada no máximo 2 vezes."""
+    import rede
+    sessoes = {'n': 0}
+    tmp = dst + '.parte'
+
+    def fazer(k):
+        try:
+            _directo(api, href, tmp, renovar=sessoes['n'] > 0 and k > 0)
+            if not _valida(tmp):
+                raise rede.ErroPassageiro('folha inválida (o GDAL não a abre)')
+            os.replace(tmp, dst)
+            return dst
+        except SessaoCDD as e:
+            sessoes['n'] += 1
+            if sessoes['n'] > 2:
+                raise rede.ErroDefinitivo('O CDD da DGT recusou a sessão da conta da Terracrua Design %d vezes seguidas (%s). '
+                                          'Verificar a conta CDD no site (Ferramentas) antes de voltar a pôr a encomenda na fila.' % (sessoes['n'], e))
+            raise rede.ErroPassageiro(str(e))
+        except rede.ErroDefinitivo as e:
+            if e.codigo in (404, 410):
+                raise rede.ErroDefinitivo('A folha %s já não existe no CDD da DGT (HTTP %d). O catálogo pode ter mudado; '
+                                          'rever a encomenda à mão.' % (base, e.codigo), e.codigo)
+            raise
+        finally:
+            if os.path.exists(tmp):
+                try:
+                    os.remove(tmp)
+                except OSError:
+                    pass
+
+    return rede.tentar(fazer, 'folha %s' % base[:60], cfg, registo, dormir)
+
+
+def _pesquisar(api, bloco, col):
+    """Pesquisa STAC pelo site. O site já repete quando está ocupado; aqui só se traduz o erro final."""
+    import rede
+    try:
+        return api.post('lidar', {'bbox': bloco, 'colecoes': [col]}, timeout=200).get('itens', [])
+    except Exception as e:
+        cod = getattr(e, 'codigo', None)
+        if cod == 400:
+            raise SemCobertura('A área está fora da cobertura LiDAR do Centro de Dados da DGT (continente e Açores).')
+        if cod == 401:
+            raise rede.ErroDefinitivo('O site não conseguiu entrar no CDD da DGT com a conta da Terracrua Design (%s). '
+                                      'Verificar a conta CDD antes de voltar a pôr a encomenda na fila.' % e, 401)
+        if (cod is not None and rede.classificar_codigo(cod) == 'passageiro') or (cod is None and rede.classificar_excepcao(e) == 'passageiro'):
+            raise rede.DGTIndisponivel('A pesquisa no Centro de Dados da DGT falhou depois de várias tentativas (%s). '
+                                       'A DGT costuma voltar ao fim de algumas horas: volte a pôr a encomenda na fila mais tarde.' % e)
+        raise
